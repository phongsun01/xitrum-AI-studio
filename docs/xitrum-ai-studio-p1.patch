+struct Proc {
+    child: Arc<Mutex<Child>>,
+    stdin: ChildStdin,
+    rx: Receiver<String>,
+}
+
+impl Proc {
+    fn kill(&self) {
+        if let Ok(mut c) = self.child.lock() {
+            let _ = c.kill();
+            let _ = c.wait();
+        }
+    }
+}
+
+impl Drop for Proc {
+    fn drop(&mut self) {
+        // Không để lại tiến trình Python (và render dở dang) mồ côi khi bỏ runner, hết hạn, hủy hoặc thoát app.
+        self.kill();
+    }
