+    def _read_json(self):
+        line = self.proc.stdout.readline()
+        self.assertTrue(line, "runner đã thoát hoặc đóng stdout")
+        try:
+            return json.loads(line)
+        except json.JSONDecodeError:
+            self.fail(f"stdout chứa dòng không phải JSON (hỏng giao thức): {line!r}")
