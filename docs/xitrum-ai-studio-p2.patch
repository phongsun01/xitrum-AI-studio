diff -ruN -x node_modules -x dist -x binaries -x __pycache__ -x target -x .git orig/src/components/WhiteboardProject.tsx work/src/components/WhiteboardProject.tsx
--- a/src/components/WhiteboardProject.tsx	1970-01-01 00:00:00.000000000 +0000
