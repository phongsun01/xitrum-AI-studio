+    ff = find_ffmpeg()
+    if ff:
+        sib = Path(ff).with_name("ffprobe.exe" if sys.platform == "win32" else "ffprobe")
+        if sib.is_file():
+            return str(sib)
+    fp = shutil.which("ffprobe")
+    if fp:
+        return fp
+    for d in _UNIX_CANDIDATES:
+        c = Path(d) / "ffprobe"
+        if c.is_file():
+            return str(c)
+    return None
 
 
