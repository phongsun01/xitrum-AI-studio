# Cấu hình mẫu cho Xitrum AI Studio
# Sao chép file này sang .env nếu cần cấu hình biến môi trường tùy chỉnh

# Đường dẫn Chrome thực tế (tùy chọn, mặc định app tự dò tìm trong Program Files)
# CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Thư mục lưu Chrome Profile riêng biệt cho Muse.ai
# CHROME_PROFILE_DIR="C:\\Users\\Default\\AppData\\Local\\XitrumAI\\chrome-profile"

# Thư mục xuất video thành phẩm mặc định
# OUTPUT_DIR="C:\\Users\\Default\\Videos\\XitrumAI_Outputs"

# Cổng khởi chạy Vite Dev Server
# VITE_PORT=1420

