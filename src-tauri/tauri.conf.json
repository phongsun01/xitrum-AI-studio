{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xitrum AI Studio",
  "version": "0.8.1",
  "identifier": "com.xitrum.ai.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xitrum AI Studio",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*",
      "../sidecar-muse/runner.mjs",
      "../sidecar-tts/tts_runner.py",
      "../sidecar-tts/requirements.txt",
      "../sidecar-whiteboard/whiteboard_runner.py",
      "../sidecar-whiteboard/requirements.txt",
      "../sidecar-whiteboard/scripts/*",
      "../sidecar-whiteboard/assets/*"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/whisper-cli"
    ]
  }
}
